# =================================
# Serende — Remote Browser System
# =================================

# IP público do servidor (obrigatório para mediasoup)
PUBLIC_IP=

# Máximo de sessões simultâneas
MAX_SESSIONS=100

# Número de workers mediasoup (padrão: número de CPUs, max 8)
NUM_WORKERS=4

# Caminho para extensões Chrome no host
EXTENSIONS_PATH=./extensions

# TURN server credentials
TURN_URL=turn:your-server:3478
TURN_USERNAME=serende
TURN_PASSWORD=serende-turn-password
