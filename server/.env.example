# Auth
AUTH_API_KEY=sua-api-key-aqui
JWT_SECRET=sua-chave-secreta-jwt-aqui
JWT_EXPIRY=24h

# Painel admin (login email + senha -> JWT).
# ADMIN_SECRET e o secret LEGADO: enquanto existir, as rotas /api/admin/*
# tambem aceitam o header X-Admin-Secret. Sem ele, so o JWT de login passa.
# ADMIN_JWT_EXPIRY (opcional) cai para JWT_EXPIRY.
ADMIN_SECRET=
ADMIN_JWT_EXPIRY=24h

# Session limits
MAX_SESSIONS=10
MAX_SESSIONS_PER_USER=3

# Server (SERENDE_PORT tem prioridade sobre PORT)
SERENDE_PORT=4201

# CORS (lista separada por virgula, ou * )
CORS_ORIGIN=*

# Rate limiting
# A chave do balde e a IDENTIDADE do tenant (tenantId do JWT ou hash da
# x-api-key), nao o IP — o MCP e um proxy local, entao chavear por IP faria
# todos os tenants compartilharem um unico balde. Trafego sem identidade
# (sem token) continua no balde por IP, com o limite abaixo.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_REQUESTS_TENANT=600

# MCP: janela de cache da validacao de sessao (ms).
# Cada tool call nao gasta mais uma request so para conferir se a sessao
# ainda existe. Menor = mais preciso, maior = menos requests.
SESSION_VALIDATION_TTL_MS=3000
